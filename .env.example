# Variables d'environnement de l'API (backend/src/CoworkingBooking.Api).
# En local, elles sont déjà dans appsettings.Development.json (voir appsettings.Development.example.json).
# Elles serviront telles quelles pour Docker et Kubernetes. Copier en .env (jamais commité).

ASPNETCORE_ENVIRONMENT=Production

# Connexion PostgreSQL
ConnectionStrings__Default=Host=localhost;Port=5432;Database=coworking;Username=coworking;Password=changer-moi

# Clé de signature des jetons JWT : au moins 32 caractères aléatoires (ex. openssl rand -hex 32)
Jwt__Key=changer-moi-par-une-cle-aleatoire-de-32-caracteres-minimum
Jwt__ExpiresHours=12

# Compte gestionnaire créé (ou mis à jour) au démarrage
Admin__Email=gestionnaire@example.ma
Admin__Password=changer-moi

# URL(s) du frontend autorisées par CORS, séparées par des virgules
Frontend__Url=http://localhost:5173

# Applique les migrations EF Core au démarrage (pratique en conteneur)
Database__MigrateOnStartup=false

# Swagger hors environnement Development
Swagger__Enabled=false
