# Variables lues par docker-compose.yml. Copier en .env (jamais commité) et remplacer les valeurs.
#   cp .env.example .env
# docker-compose.yml les transmet à l'API sous leur nom ASP.NET Core
# (ConnectionStrings__Default, Jwt__Key, Admin__Email, ...) : voir la section "backend" du fichier.

# --- PostgreSQL ---
POSTGRES_USER=coworking
POSTGRES_DB=coworking
POSTGRES_PASSWORD=changer-moi

# --- API ---
# Clé de signature des jetons JWT : au moins 32 caractères aléatoires (ex. openssl rand -hex 32).
# L'API refuse de démarrer si elle est plus courte.
JWT_KEY=changer-moi-par-une-cle-aleatoire-de-32-caracteres-minimum

# Compte gestionnaire créé (ou mis à jour) au démarrage de l'API
ADMIN_EMAIL=gestionnaire@example.ma
ADMIN_PASSWORD=changer-moi

# Swagger sur http://localhost:5080/swagger (true pour la démo, false sinon)
SWAGGER_ENABLED=false

# --- Ports sur la machine locale ---
FRONTEND_PORT=8080
BACKEND_PORT=5080
