<?xml version="1.0" encoding="utf-8"?>
<!-- Couverture de code : dotnet test (avec settings coverlet.runsettings) -->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Format>cobertura</Format>
          <Include>[CoworkingBooking.Api]*</Include>
          <!-- Code généré : migrations EF Core et expressions régulières générées -->
          <ExcludeByFile>**/Migrations/*.cs,**/obj/**/*.cs</ExcludeByFile>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
